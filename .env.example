    # Copy to `.env` and fill in values. `.env` is gitignored — do not commit secrets.
# For Docker deploy on a server: copy to `~/invoices/.env` (see README / docker-compose).
# For `npm run dev` without Docker, you need DATABASE_URL and typically local AUTH_URL (see below).

# Public URL of the web app — must match the URL in the browser (scheme + host + port).
# NextAuth rewrites /api/auth/* requests to this origin: if it is wrong, Google OAuth returns
# you to the wrong host (e.g. https://localhost:3000 while you use another port or hostname).
# Local dev: http://localhost:3000 — Production: https://your-domain.example.com
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Canonical origin for SEO (sitemap, robots, OpenGraph, JSON-LD, hreflang).
# Origin only — scheme + host, no path, no trailing slash.
# Production: https://involoops.com — Local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MinIO S3 API. Nothing outside the server needs to reach this: uploads and
# downloads are streamed through the app, so it can stay on the private
# network. Compose maps it to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Database (Docker Compose password; used in compose to build DATABASE_URL for the app container)
POSTGRES_PASSWORD=change-me-strong-password

# Password of the non-superuser runtime role (invoices_app; sandbox:
# invoices_sandbox_app). The app serves traffic as this role and cannot
# UPDATE/DELETE the audit log; boot migrations still run as the owner above
# via MIGRATE_DATABASE_URL. Create the role once per environment:
# scripts/sql/create-app-role.sql. URL-safe characters only — the value is
# interpolated into DATABASE_URL.
POSTGRES_APP_PASSWORD=change-me-different-strong-password

# pgAdmin (Docker only) — login at http://<host>:5051 — add server: Host postgres, Port 5432, User invoices
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# Postgres connection for local `npm run dev` / Drizzle (adjust user, password, db name)
DATABASE_URL=postgresql://user:password@localhost:5432/invoices

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Bearer token for POST /api/cron/* (funnel emails, purge deletions). Must match
# what you pass from the host cron script (scripts/cron-funnel-emails.sh). Generate:
#   openssl rand -base64 32
CRON_SECRET=

# Email marketing funnels (SES drip + event-driven enrollments). false = master off (no sends, no new entries; exits/unsubscribe still run).
# Omit or true to enable.
EMAIL_FUNNELS_ENABLED=true

# Sponsored partner offers (home dashboard card and top-bar slot). Off unless set to true.
# Campaigns live in the sponsor_campaigns table and are created inactive.
SPONSORS_ENABLED=false

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# MinIO (same credentials are often passed through to the app as S3_* in Docker)
MINIO_ROOT_USER=invoicesminio
MINIO_ROOT_PASSWORD=change-me-minio-password
# Console (s3.) ↔ API (s3api.) — required for bucket listing in the MinIO web UI
MINIO_SERVER_URL=https://s3api.involoops.com
MINIO_BROWSER_REDIRECT_URL=https://s3.involoops.com

# Dashboard aggregates: convert mixed invoice currencies to one display currency (ISO 4217).
DEFAULT_DISPLAY_CURRENCY=ILS
# Optional FX multipliers (1 unit of source currency → USD). Adjust for your reporting period.
FX_ILS_TO_USD=0.35
# FX_EUR_TO_USD=1.08
# FX_GBP_TO_USD=1.27

# Optional: Claude vision for scanned PDFs
ANTHROPIC_API_KEY=

# Optional: override the Anthropic models used by the extraction pipeline.
# Defaults are baked into src/lib/extraction/anthropic-models.ts so leaving
# these unset is safe. Override to roll out a new model (or roll back to a
# cheaper/older one) without redeploying code.
#   - ANTHROPIC_EXTRACTION_MODEL: text + vision invoice field extraction
#     and the BYOK key validator (so users see "your tier doesn't include
#     this model" at Save-key time, not on the next upload).
#   - ANTHROPIC_SEGMENTATION_MODEL: multi-invoice PDF segmentation (Haiku).
ANTHROPIC_EXTRACTION_MODEL=
ANTHROPIC_SEGMENTATION_MODEL=

# --- Public REST API (docs/api/) ----------------------------------------
# Server-side pepper mixed into the HMAC of every public-API key secret.
# Required when any `inv_live_*` / `inv_test_*` key has been issued — without
# it, key authentication will reject every request. Generate once with:
#   openssl rand -hex 32
# Rotating this value invalidates ALL existing API keys.
API_KEY_PEPPER=

# --- MCP OAuth (Claude connector) ----------------------------------------
# Second auth path for https://involoops.com/api/mcp. API keys keep working.
# InvoLoops creates this client and emails the id + secret to
# mcp-review@anthropic.com (Anthropic stores them; they do not issue them).
# Leave the secret empty to keep OAuth off. Generate with:
#   openssl rand -base64 32
# Redirect registered for hosted Claude (Claude.ai, Desktop, mobile, Cowork):
#   https://claude.ai/api/mcp/auth_callback
# Token auth: client_secret in the form body, or HTTP Basic. PKCE S256 required.
# Access tokens last 1 hour; refresh tokens (offline_access) last 30 days.
ANTHROPIC_MCP_CLIENT_ID=involoops-claude
ANTHROPIC_MCP_CLIENT_SECRET=
# Private RSA JWK Set, one line. Generate once: npm run oauth:gen-jwks
# Put the real value only in the server env. Empty keeps the placeholder out of git.
# A missing key, or kid keystore-CHANGE-ME, refuses to boot while OAuth is on.
OAUTH_JWKS=
# Comma-separated extra redirect URIs for local tests only. Production stays empty.
# Example: http://localhost:3000/oauth/dev-callback
OAUTH_DEV_REDIRECT_URIS=

# Studio auto-receipt on Stripe payment.
# When a subscription payment is collected (Stripe `invoice.paid`), the app
# acts as the operator's own billing account and generates an outbound
# TAX_INVOICE_RECEIPT
# for the paying subscriber by calling the public REST API (/api/v1/*).
#
# STUDIO_API_KEY: a LIVE public API key (`inv_live_...`) belonging to the
# operator's own account, with scopes: customers:read, customers:write,
# outbound:write, outbound:issue. Generate it in Settings → Developers.
STUDIO_API_KEY=

# Dedicated key for TalkToPC InvoLoops MCP (NOT the studio receipt key above).
# Create in Settings → API Keys; suggested scopes: me:read, customers:read,
# invoices:read, outbound:read (add outbound:write/issue only if MCP should mutate).
# Rotate on TTP: INVOLOOPS_MCP_API_KEY=inv_live_... TTP_API_KEY=sk_... \
#   npx tsx scripts/update-ttp-involoops-mcp-key.ts
INVOLOOPS_MCP_API_KEY=
# STUDIO_RECEIPT_MODE controls the behaviour:
#   off    → disabled (default)
#   draft  → create the receipt as a draft only (review + issue manually)
#   issue  → create AND issue (allocates the fiscal number, signs, submits to
#            SHAAM — irreversible). Also requires `invoice.paid` to be enabled
#            on the Stripe webhook endpoint.
STUDIO_RECEIPT_MODE=off

# AES-256 key for encrypting webhook endpoint signing secrets at rest
# (the server must know plaintext to sign outgoing deliveries). Optional:
# falls back to USER_API_KEY_ENCRYPTION_SECRET → AUTH_SECRET if unset.
# Generate with: openssl rand -hex 32
# WEBHOOK_SECRET_ENCRYPTION_SECRET=

# Dev-only override — allow webhook URLs to resolve to private IPs
# (localhost, 10.*, 192.168.*). Set to 1 to test with a local receiver
# without tunnelling. NEVER set in production.
# WEBHOOK_ALLOW_PRIVATE_IPS=1

# Optional: dedicated secret for encrypting per-user Claude API keys at rest
# (users can BYOK their own Anthropic key in /settings to unlock the
# Enterprise plan — 500 invoices/month with no charge from us). Generate with:
#   openssl rand -base64 32
# If unset, the app derives the AES key from AUTH_SECRET; setting a dedicated
# value lets you rotate BYOK encryption independently of sessions.
USER_API_KEY_ENCRYPTION_SECRET=

# Transactional + funnel email via Amazon SES (SESv2). Verify your sending
# identity (domain or address) in the AWS SES console before going live.
# Use a dedicated IAM user with `ses:SendEmail` only.
SES_AWS_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Verified sender, e.g. "InvoLoops <noreply@yourdomain.com>"
SES_FROM_EMAIL=
# Optional SES configuration set for engagement tracking / event publishing
# SES_CONFIGURATION_SET=
# Optional SES contact list name for marketing emails (unsubscribe handling)
# SES_CONTACT_LIST=
# Where all admin notifications go — signups, contact form, BYOK key saves,
# new subscriptions. No default: leave it unset and these notifications are
# skipped rather than sent to someone else's inbox.
# ADMIN_EMAIL=owner@example.com
# The contact the privacy policy and terms name for data requests, security
# reports and legal notices (src/lib/legal/contact.ts). A role address, not a
# person's mailbox. Defaults to privacy@involoops.com — set it to your own.
# LEGAL_CONTACT_EMAIL=privacy@example.com

# --- When running Next.js locally against MinIO/S3 (not only via Docker Compose) ---
# The app reads these names (see `src/lib/storage.ts`). Compose maps S3_PUBLIC_ENDPOINT → S3_ENDPOINT.
# Put/Get use S3_INTERNAL_ENDPOINT when set (Docker: http://minio:9000), else S3_ENDPOINT.
# Neither has to be reachable from a browser — the app streams the bytes.
# S3_ENDPOINT=http://localhost:9105
# S3_INTERNAL_ENDPOINT=http://localhost:9105
# S3_BUCKET=invoices
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Google Tag Manager (optional — public id only). Leave unset and no GTM
# script, iframe or preconnect is emitted at all; there is no default container.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Gmail-forwarding invoice intake ---
# Dedicated GCP project (NOT the same OAuth client as AUTH_GOOGLE_*).
# Create with: scripts/gmail-auth.mjs (one-shot OAuth helper).
# Required for the webhook + watch-renewal cron to function — leave blank
# to disable email intake entirely.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
# The mailbox we read from. Forwarding rules on involoops.com point here.
GMAIL_INBOX_ADDRESS=intake@example.com
# Pub/Sub topic the Gmail watch publishes notifications to. Format:
# projects/<gcp-project-id>/topics/<topic-name>
# Use the numeric/string PROJECT ID from GCP (e.g. gen-lang-client-0944377220),
# NOT your website domain (involoops.com is wrong in the projects/ segment).
GMAIL_PUBSUB_TOPIC=
# Audience claim configured on the Pub/Sub push subscription's OIDC
# token — used to verify push deliveries weren't forged. Set this to the
# webhook URL, e.g. https://your-domain.com/api/webhooks/gmail
GMAIL_PUBSUB_AUDIENCE=

# --- Spec 04: digital signing (חשבונית ירוקה) ----------------------------
# Stable identifier for the active signing key. Published alongside the
# signature on every issued PDF and referenced by document_signatures.key_id.
# Bootstrap: npx tsx scripts/generate-dev-signing-key.ts --env dev
# Production: npx tsx scripts/generate-dev-signing-key.ts --env production --private-key-out <path>
# Sandbox:   npx tsx scripts/generate-dev-signing-key.ts --env sandbox --private-key-out <sandbox path>
SIGNING_KEY_ID=

# Production. Absolute path of the PEM file, mounted read-only into the
# app (see docker-compose.yml). When this is set, SIGNING_PRIVATE_KEY_PEM
# is ignored. The private key itself does not belong in this file.
SIGNING_PRIVATE_KEY_FILE=

# Dev only. RSA-2048 PKCS#8 PEM. Multiline PEM is accepted either
# literally (dotenv with surrounding quotes) or with `\n` escape sequences
# (what `--env dev` prints). Never commit this value. Leave empty in
# production once SIGNING_PRIVATE_KEY_FILE is set.
SIGNING_PRIVATE_KEY_PEM=

# Public origin used in the QR-code verify URL printed on signed PDFs.
# Falls back to AUTH_URL or http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=

# --- PAdES-B: PDF-artifact signing (separate from Spec 04 JSON signing) --
# Embeds a real /Type /Sig dictionary + detached CMS container into every
# non-draft invoice PDF (archive copy and on-demand download both).
# Adobe Reader shows the blue ribbon; `pdfsig` validates the signature.
# Complements — does not replace — the Spec 04 canonical-JSON signature.
#
# Bootstrap the dev keystore once with:
#   export INVOLOOPS_PDF_SIGNING_P12_PASSWORD='<strong-passphrase>'
#   ./scripts/generate-dev-pdf-signing-keystore.sh
# If these env vars are unset, signing is silently skipped in dev and
# PDFs are emitted without the /Sig dict — `PDF_GENERATED.padesSigned`
# records which variant was produced. In production, set all three.

# Absolute path to the PKCS#12 keystore (.p12 with cert + private key).
INVOLOOPS_PDF_SIGNING_P12_PATH=

# Passphrase that decrypts the .p12. Never commit this value.
INVOLOOPS_PDF_SIGNING_P12_PASSWORD=

# Informational alias recorded alongside signatures (defaults to
# `involoops-pdf-dev`). Not used to locate the key — the .p12 carries a
# single entry and node-forge loads it by default.
INVOLOOPS_PDF_SIGNING_ALIAS=involoops-pdf-dev

# --- Spec 05: 7-year immutable archive bucket ---------------------------
# Dedicated MinIO/S3 bucket for COMPLIANCE-mode Object Lock archive.
# Must be distinct from the everyday invoice-PDF bucket. Bootstrap once
# via `npx tsx scripts/setup-archive-bucket.ts`. Once enabled, Object
# Lock cannot be disabled — that is the intended regulatory behaviour.
S3_ARCHIVE_BUCKET=invoices-archive

# --- Off-site backup (scripts/offsite-backup.sh, host crontab) -----------
# Database dump (age-encrypted), uploaded files and the signed archive,
# copied nightly to AWS S3 in Israel. Both buckets have versioning and
# Object Lock with a default retention, so everything written is locked.
# The IAM user may write and read but never delete. Runbook:
# docs/offsite-backup.md. Leave unset where there is no off-site copy.
# OFFSITE_S3_REGION=il-central-1
# OFFSITE_S3_BACKUP_BUCKET=your-offsite-backup-bucket
# OFFSITE_S3_ARCHIVE_BUCKET=your-offsite-archive-bucket
# OFFSITE_AWS_ACCESS_KEY_ID=
# OFFSITE_AWS_SECRET_ACCESS_KEY=
# The age PUBLIC key (age1…) dumps are encrypted to. The private key — the
# same one that decrypts the sops-encrypted .env — never stays on the server;
# it is needed only to restore.
# OFFSITE_AGE_RECIPIENT=age1…
# Optional dead-man's switch (e.g. healthchecks.io): pinged on success,
# <url>/fail on failure; no ping at all also raises its alert.
# BACKUP_HEALTHCHECK_URL=

# --- Spec 07: SHAAM (ITA) OAuth ------------------------------------------
# Controls which ITA environment InvoLoops calls. Use UAT for dev/test,
# PROD when real tax invoices are issued. Bootstrap values for
# client_id / client_secret come from openapi.taxes.gov.il after you
# register the app; see docs/ita-compliance/KNOWN_ISSUES.md.
SHAAM_ENV=UAT
SHAAM_CLIENT_ID=
SHAAM_CLIENT_SECRET=
# The callback URL must match what's configured in the developer
# portal. Local dev: http://localhost:3000/api/shaam/oauth/callback
SHAAM_REDIRECT_URI=http://localhost:3000/api/shaam/oauth/callback
# AES-256 key (any high-entropy string) for encrypting refresh /
# access tokens at rest. Falls back to AUTH_SECRET with a namespaced
# salt if unset.
SHAAM_TOKEN_ENCRYPTION_SECRET=

# The OAuth endpoint paths and base URLs are env-configurable because
# the ITA has historically shifted them. Defaults match the documented
# v2.0 product (Israel Invoice Model 7/2024) — note that v2 moved to
# a different host (`ita-api.taxes.gov.il`) than v1 (`openapi.taxes.gov.il`).
# OAuth still issues tokens at `openapi.taxes.gov.il/shaam/<env>/longtimetoken/...`,
# so the OAuth host and the clearance host can differ. Override only
# if a portal probe says otherwise.
# SHAAM_BASE_URL_UAT=https://ita-api.taxes.gov.il
# SHAAM_BASE_URL_PROD=https://ita-api.taxes.gov.il
# SHAAM_AUTHORIZE_PATH=/shaam/tsandbox/longtimetoken/oauth2/authorize
# SHAAM_TOKEN_PATH=/shaam/tsandbox/longtimetoken/oauth2/token
# SHAAM_REVOKE_PATH=/shaam/tsandbox/longtimetoken/oauth2/revoke
# OAuth scope on the authorize URL (must match portal product subscription).
# Invoices v2 Approval OpenAPI `security` accepts oauth2 scope `scope` or
# `invoices_scope` (see portal invoices_v2.json). Product catalog also lists
# `invoices_approval_scope` — if clearance returns 401 invalid_token with
# that scope, use `invoices_scope` and re-authorize (refresh does not add scopes).
# Legacy irspinvoices product: irsp_invoices_scope
# SHAAM_OAUTH_SCOPE=invoices_scope

# Outbound HTTP proxy for SHAAM traffic (OAuth + clearance). The ITA
# refuses connections from our hosting IP, so when the app runs abroad
# every shaam call is tunnelled through a proxy that egresses from
# Israel. Format: http://USER:PASSWORD@HOST:PORT. Leave unset to call
# ITA directly from the app process — correct when the host itself has
# Israeli egress, and leaving it set on such a host produces misleading
# failures.
#
# Full runbook, attempt log, and verification:
# docs/ita-compliance/11-israel-egress.md
#
# The restriction is GEOGRAPHIC, not datacenter-wide (verified
# 2026-09-29 from AWS il-central-1: the OAuth token endpoint answered
# 400 and the clearance endpoint answered 401 on the bearer). Any host
# with Israeli egress works — an Israeli cloud VM is fine, and a
# residential/ISP line is not required.
#
# Changing this value needs a container restart: src/lib/shaam/proxy.ts
# caches the ProxyAgent for the process lifetime.
#
# NOT SUFFICIENT on its own: being in an Israeli region. The OAuth host
# filters by IP range — AWS il-central-1 addresses in 16.164.0.0/16 are
# dropped while 51.16/51.84 are accepted. Verify a candidate address
# before relying on it; docs/ita-compliance/11-israel-egress.md has the
# table and a console-only probe.
#
# Example (self-hosted squid on an IL-egress box). No credentials: the
# security group restricts the source and squid only permits CONNECT to
# .taxes.gov.il:443, so there is no proxy password to leak or rotate.
# SHAAM_PROXY_URL=http://203.0.113.10:3128
SHAAM_PROXY_URL=

# Master switch for the proxy above. Default (unset) is ON: the proxy is
# used whenever SHAAM_PROXY_URL is set. Set to 0 (also accepts false /
# no / off) to call ITA directly from the app process while KEEPING
# SHAAM_PROXY_URL configured — the case for this is ITA allowlisting the
# app server's own address, after which the proxy is an unnecessary hop
# but worth keeping on hand as a fallback. Clearing SHAAM_PROXY_URL has
# the same runtime effect; this flag just lets the value survive.
#
# Also needs a container restart (the ProxyAgent is process-cached), and
# scripts/verify-shaam-proxy.ts + scripts/print-shaam-config.ts honour
# it, so they report the egress the app will actually use.
SHAAM_PROXY_ENABLED=1

# When 1, only one SHAAM clearance pipeline (token fetch → ITA POST)
# per business_entity_id runs at a time cluster-wide (Postgres session
# advisory lock). Contention returns skippedReason tenant_shaam_serialize_busy.
SHAAM_TENANT_SUBMIT_SERIALIZE=0

# --- Spec 08: SHAAM invoice submission -----------------------------------
# Force a low allocation-threshold in UAT so small test invoices
# exercise the above-threshold path. Leave unset in production.
SHAAM_THRESHOLD_OVERRIDE=

# Verbose debug logging of SHAAM request/response metadata (tokens
# stay redacted either way). Set to 1 only when diagnosing.
SHAAM_DEBUG=0

# Endpoint path for POSTing invoice clearance payloads. Defaults to
# the v2 single-invoice approval path. UAT uses `/tsandbox/`, PROD
# uses `/production/`. Override if the ITA portal advertises a
# different route.
# SHAAM_INVOICE_PATH=/shaam/tsandbox/Invoices/v2/Approval
#
# SHAAM_DECISION_PATH — path PREFIX for the decision-update service
# (v2.0 spec §4). The endpoint name is appended: /Cancel, /Continue or
# /FurtherObjection. Defaults to /shaam/tsandbox/InvoiceDecisionApi/v1
# (or /shaam/production/... when SHAAM_ENV=PROD). Shares
# SHAAM_CLEARANCE_BASE_URL for the host.
# SHAAM_DECISION_PATH=/shaam/tsandbox/InvoiceDecisionApi/v1

# Until Form 513 approval, only platform admins can issue outbound
# documents (including credit notes). Drafts stay open for every
# account. Set to 1 after ITA approval to open issuing to everyone.
# The sandbox stack (SIGNING_ENVIRONMENT=sandbox) may issue without this.
# ITA_ISSUANCE_APPROVED=1
# Comma-separated emails that may issue without being admins, and
# before ITA_ISSUANCE_APPROVED. Does not grant isAdmin.
# ITA_ISSUANCE_ALLOW_EMAILS=reviewer@example.com

# Software registration number (N9) issued by ITA after Form 513
# approval — sent as `accounting_software_number` on every clearance
# request. Until you have one, the v2 spec (Table 2.1 item 15)
# explicitly allows falling back to "the Pvt. Co./identity of the
# document producer" — we use SOFTWARE_HOUSE_VAT_NUMBER below as
# that fallback. Set this only after ITA issues your real N9.
# SHAAM_ACCOUNTING_SOFTWARE_NUMBER=
# Fictional customer VAT for admin “Test clearance API” probe (UAT default 777777715).
# SHAAM_PROBE_CUSTOMER_VAT=

# --- Spec 10: Uniform Structure (מבנה אחיד v1.31) export ---------------
# A000 file-header identifiers. Encoding is fixed to ISO-8859-8-i
# (charset code 1) per spec §2.3.
#
# REQUIRED — the three below have no defaults, and the export refuses to
# run without them. They declare to the Tax Authority who wrote the
# software behind the books in the file. A default would make an
# unconfigured instance file its tenants' records under someone else's
# company, which is a false statement to a tax authority that the
# operator would have no reason to suspect. Use the details on your own
# ITA software registration, character for character.
#
# Software name printed in A000 field 1007 (max 20 chars), and the
# edition in field 1008. The edition defaults to "1".
# SOFTWARE_NAME=
# SOFTWARE_VERSION=1
#
# Software house identifiers — A000 fields 1009 (your VAT number, 9
# digits) and 1010 (your company name, max 20 chars).
# SOFTWARE_HOUSE_VAT_NUMBER=
# SOFTWARE_HOUSE_NAME=
#
# Software registration code — A000 field 1006. Per v1.31 §3.1 this
# is **N8** (8 digits, NOT the SHAAM-API N9). Issued by the ITA
# after Form 513 / מרשם תוכנה approval. Pre-approval, leave unset —
# A000 is stamped with the test placeholder "99999999" (the offline
# simulator rejects all-zeros as "field invalid/zeroed").
# SOFTWARE_REGISTRATION_CODE=
#
# Software model declarations. Defaults match the InvoLoops design
# (multi-year, invoicing-only — no general ledger):
#   SOFTWARE_TYPE      — A000 field 1011: "1" single-year / "2" multi-year
#   ACCOUNTING_METHOD  — A000 field 1013: "1" single-entry / "2" double-entry
#                        (spec defines no "0" — simulator rejects it)
# SOFTWARE_TYPE=2
# ACCOUNTING_METHOD=1
#
# Compression software written into A000 field 1030 (max 20 chars).
# Defaults to "ZIP".
# COMPRESSION_SOFTWARE_NAME=ZIP

# ── Stripe (billing) ─────────────────────────────────────────────────
# Required for subscriptions. Without them the billing routes fail and the
# webhook rejects every delivery.
#   STRIPE_SECRET_KEY     — server-side API key (`sk_live_…` / `sk_test_…`).
#   STRIPE_WEBHOOK_SECRET — signing secret of the webhook endpoint
#                           (`whsec_…`). The handler verifies every delivery
#                           against it; a wrong value means all events are
#                           rejected, which is the intended failure mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Signing sandbox guard ────────────────────────────────────────────
# Stops a sandbox deployment from signing documents with a production key.
#   SIGNING_ENVIRONMENT             — "sandbox" turns the guard on. Anything
#                                     else (or unset) is treated as production.
#   SIGNING_PRODUCTION_KEY_IDS_FILE — required when SIGNING_ENVIRONMENT is
#                                     "sandbox": a file listing the production
#                                     key ids the sandbox must refuse to load.
#                                     Boot fails if it is missing.
# SIGNING_ENVIRONMENT=sandbox
# SIGNING_PRODUCTION_KEY_IDS_FILE=/run/secrets/production-key-ids.txt

# ── Optional overrides ───────────────────────────────────────────────
# APP_URL — fallback for NEXT_PUBLIC_APP_URL, used to build absolute links in
#   the PDF signature stamp and ITA notification emails. Set NEXT_PUBLIC_APP_URL
#   instead unless you need a server-only value; this exists for older setups.
# APP_URL=
#
# INVOICE_DOMAIN — your own mail domain, used by Gmail intake to recognise
#   addresses belonging to this instance. Defaults to "involoops.com", which is
#   wrong for any other deployment, so set it if you use the Gmail intake.
# INVOICE_DOMAIN=example.com
#
# SHAAM_CLEARANCE_BASE_URL — overrides the host used for clearance (invoice
#   allocation) calls, which lives on a different subdomain from the OAuth host
#   and has moved before. Leave unset to use the built-in default.
# SHAAM_CLEARANCE_BASE_URL=
#
# NEXTAUTH_SECRET — legacy alias for AUTH_SECRET, still read as a fallback.
#   Set AUTH_SECRET; this is only for configs predating the rename.
# NEXTAUTH_SECRET=

# ── Debug logging ────────────────────────────────────────────────────
# Both take exactly "1" to enable; anything else is off. Verbose and intended
# for diagnosing a specific problem, not for leaving on in production.
#   INVOICE_DEBUG_AUTH — auth flow tracing (src/lib/auth-debug.ts)
#   INVOICE_DEBUG_DB   — Postgres connection lifecycle (src/db/index.ts)
# INVOICE_DEBUG_AUTH=1
# INVOICE_DEBUG_DB=1
