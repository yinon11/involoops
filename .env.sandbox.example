# Sandbox stack (`~/invoices_sandbox`, docker-compose.sandbox.yml)
# Copy to `.env.sandbox` (gitignored) and fill secrets. Deploy copies it to the server as `.env.sandbox`.
# Run Compose with `docker compose --env-file .env.sandbox -f docker-compose.sandbox.yml …`.
#
# Local `npm run dev`: Next.js only auto-loads `.env`, `.env.local`, `.env.development*`
# — not this file. For local work, put values in `.env.local`. Keep `AUTH_URL` / `NEXTAUTH_URL`
# identical to the URL you open in the browser (e.g. `http://localhost:3000`); you can still
# point `DATABASE_URL` and other keys at sandbox resources. Using this file as-is locally while
# browsing `localhost` breaks Google OAuth (callback + cookies expect the sandbox origin).

AUTH_URL=https://sandbox.involoops.com
NEXTAUTH_URL=https://sandbox.involoops.com

# MinIO — browser must reach these hosts (TLS reverse proxy to 9107 / 9108 on the host)
S3_PUBLIC_ENDPOINT=https://s3api-sandbox.involoops.com
MINIO_SERVER_URL=https://s3api-sandbox.involoops.com
MINIO_BROWSER_REDIRECT_URL=https://s3-sandbox.involoops.com

POSTGRES_PASSWORD=generate-strong-password
# pgAdmin rejects addresses like *@*.local — use a normal domain.
PGADMIN_DEFAULT_EMAIL=pgadmin-sandbox@involoops.com
PGADMIN_DEFAULT_PASSWORD=generate-strong-password

DATABASE_URL=postgresql://invoices_sandbox:generate-strong-password@localhost:5432/invoices_sandbox

AUTH_SECRET=openssl-rand-base64-32
# One-line private JWK Set from `npm run oauth:gen-jwks`. Use a different key than production.
OAUTH_JWKS=
CRON_SECRET=openssl-rand-base64-32

EMAIL_FUNNELS_ENABLED=false

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

MINIO_ROOT_USER=invoices-sandbox-minio
MINIO_ROOT_PASSWORD=generate-strong-minio-password

DEFAULT_DISPLAY_CURRENCY=ILS

S3_ARCHIVE_BUCKET=invoices-archive-sandbox

# Optional: same as production pattern for SES, Stripe test keys, Gmail (often disabled in sandbox)
# GMAIL_PUBSUB_TOPIC=
# GMAIL_PUBSUB_AUDIENCE=https://sandbox.involoops.com/api/webhooks/gmail

# Sandbox document signing. Mint with:
#   npx tsx scripts/generate-dev-signing-key.ts --env sandbox \
#     --private-key-out /etc/involoops/signing-private-key-sandbox.pem
# Compose forces SIGNING_ENVIRONMENT=sandbox and the sandbox key file.
# Never set this to a production key id (involoops-prod-… or involoops-dev-…).
# SIGNING_KEY_ID=
# Leave the PEM empty. The private key lives only in the sandbox key file.
# SIGNING_PRIVATE_KEY_PEM=

NEXT_PUBLIC_APP_URL=https://sandbox.involoops.com
