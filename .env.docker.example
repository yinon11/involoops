# Copy to .env on the server: cp .env.docker.example .env && edit secrets
#
# docker-compose.yml uses `env_file: .env` for the app service: every variable you set here
# is passed into the container. A few names are overridden for Compose (DATABASE_URL →
# postgres service, S3_* → MinIO mapping, AUTH_URL for NEXTAUTH_URL).

# Public URL of the web app (scheme + host; include port only if non-default)
AUTH_URL=https://involoops.com
NEXTAUTH_URL=https://involoops.com

# Canonical origin for SEO surfaces (sitemap, robots, OG, JSON-LD, hreflang).
# Origin only — scheme + host, no path, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://involoops.com

# MinIO S3 API. No public hostname needed: uploads and downloads are streamed
# through the app, so MinIO can stay on the Compose network.
S3_PUBLIC_ENDPOINT=http://minio:9000
# docker-compose also sets S3_INTERNAL_ENDPOINT=http://minio:9000 on the app
# service, which takes precedence for server-side Put/Get.

# Database
POSTGRES_PASSWORD=change-me-strong-password

# pgAdmin at http://<host>:5051 — register server: Host postgres, Port 5432, Maintenance DB invoices, User invoices
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin-password

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
# One-line private JWK Set from `npm run oauth:gen-jwks`. Required when MCP OAuth is on.
OAUTH_JWKS=
# Optional — Google sign-in (OAuth client type: Web; add authorized redirect URI above)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# MinIO (same credentials used by the app for S3)
MINIO_ROOT_USER=invoicesminio
MINIO_ROOT_PASSWORD=change-me-minio-password
# Public URLs — Console and API must match your reverse proxy (fixes "loading forever" in Console UI)
MINIO_SERVER_URL=https://s3api.involoops.com
MINIO_BROWSER_REDIRECT_URL=https://s3.involoops.com

# Optional: Claude vision for scanned PDFs
ANTHROPIC_API_KEY=

# Stripe (subscriptions / checkout — required for billing UI)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
